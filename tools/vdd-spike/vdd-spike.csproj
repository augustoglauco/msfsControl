<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Ferramenta de validação isolada (NÃO faz parte do host): confirma se o driver parsec-vdd
    (https://github.com/nomi-san/parsec-vdd) cria um monitor virtual de verdade e se o Windows o
    enumera normalmente, antes de investir na integração real no MonRem.Host.
    Rodar só em Windows, com o driver parsec-vdd já instalado. Veja README.md desta pasta.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
