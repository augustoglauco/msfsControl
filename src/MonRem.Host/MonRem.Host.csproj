<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>monrem-host</AssemblyName>
    <UserSecretsId>monrem-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonRem.Host.Core\MonRem.Host.Core.csproj" />
  </ItemGroup>

  <!-- Serviço do Windows: só no Windows (no Linux roda como console, útil para testes com o sim falso). -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);WINDOWS_SERVICE</DefineConstants>
  </PropertyGroup>

  <!--
    Adaptadores do MSFS: compilados só quando o SDK do MSFS 2024 está instalado
    (variável MSFS2024_SDK ou MSFS_SDK, ou -p:MsfsSdkDir=...) e o WASimCommander
    foi baixado para lib/WASimCommander (ver docs/desenvolvimento.md).
  -->
  <PropertyGroup>
    <MsfsSdkDir Condition="'$(MsfsSdkDir)' == ''">$(MSFS2024_SDK)</MsfsSdkDir>
    <MsfsSdkDir Condition="'$(MsfsSdkDir)' == ''">$(MSFS_SDK)</MsfsSdkDir>
    <MsfsSdkDir Condition="'$(MsfsSdkDir)' != '' And !HasTrailingSlash('$(MsfsSdkDir)')">$(MsfsSdkDir)\</MsfsSdkDir>
    <HasMsfs Condition="'$(OS)' == 'Windows_NT' And '$(MsfsSdkDir)' != '' And Exists('$(MsfsSdkDir)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">true</HasMsfs>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasMsfs)' == 'true'">
    <ProjectReference Include="..\MonRem.Host.Msfs\MonRem.Host.Msfs.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(HasMsfs)' == 'true'">
    <DefineConstants>$(DefineConstants);MSFS</DefineConstants>
  </PropertyGroup>
</Project>
